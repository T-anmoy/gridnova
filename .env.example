# Copy to .env.local and fill in real values for local development.

# Base URL of the FastAPI backend. Used by every dashboard API call, the
# public proposal-accept page, and Ask Nova — this is the ONLY backend-URL
# env var the frontend reads. Do not introduce a differently-named variable
# for this (e.g. NEXT_PUBLIC_BACKEND_URL) — it will silently be ignored.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Clerk keys — get these from your Clerk instance's dashboard.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Production kill-switch for Ask Nova's live chat. Uncomment and set to
# "false" to disable the backend-connected chat and fall back to FAQ-only
# quick answers (no network call). Enabled by default when unset.
# NEXT_PUBLIC_ASK_NOVA_ENABLED=false

# Resend API key — server-only, powers the notification emails sent by
# app/api/estimate-request, app/api/configurator-lead, and app/api/contact.
# Without it, those routes return an honest 503 instead of a fake success.
RESEND_API_KEY=

# Where the three routes above send their notification emails. Accepts a
# comma-separated list. Falls back to info@gridnova.in when unset.
ESTIMATE_NOTIFY_EMAIL=

# Shared secret for the server-to-server lead mirror (estimate-request,
# configurator-lead, contact -> backend CRM). Server-only — never prefix this
# with NEXT_PUBLIC_, it must never reach the browser. Must match the backend's
# own INTERNAL_API_KEY. When unset, the mirror calls omit the internal-key and
# customer-IP headers entirely and behave exactly as they did before this
# existed (a visitor's rate limit is then shared with every other visitor).
INTERNAL_API_KEY=

# Associate Network switch. "true" shows Apply / Sign-in on the Careers page and
# opens the /associates/* and /preferred/* routes; "false" shows "opening soon"
# everywhere. When unset: open in development, CLOSED in production builds.
# Set to "true" only once the backend (with territory data loaded) is deployed.
# NEXT_PUBLIC_ASSOCIATE_PORTAL_OPEN=true
