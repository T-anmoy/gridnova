# Copy to .env.local and fill in real values for local development.

# Base URL of the FastAPI backend. Used by every dashboard API call, the
# public proposal-accept page, and Ask Nova — this is the ONLY backend-URL
# env var the frontend reads. Do not introduce a differently-named variable
# for this (e.g. NEXT_PUBLIC_BACKEND_URL) — it will silently be ignored.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Clerk keys — get these from your Clerk instance's dashboard.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Production kill-switch for Ask Nova's live chat. Uncomment and set to
# "false" to disable the backend-connected chat and fall back to FAQ-only
# quick answers (no network call). Enabled by default when unset.
# NEXT_PUBLIC_ASK_NOVA_ENABLED=false
