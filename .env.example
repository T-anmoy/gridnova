# Copy to .env.local and fill in real values for local development.
# This file is documentation: it holds NO real values and is tracked by git
# (.gitignore has `!.env.example`). See README "Environment matrix" for what
# Vercel Production / Preview / Development each need.
#
# NEXT_PUBLIC_* values are inlined into the browser bundle at BUILD time and are
# public — never put a secret in one. Everything else is server-only.

# ── Backend ──────────────────────────────────────────────────────────────────
# Base URL of the FastAPI backend (no trailing slash). Read in exactly one place
# (lib/config.ts → API_BASE_URL). A production build FAILS when this is missing
# or points at localhost, so production can never silently talk to a dev server.
# Do not introduce a differently-named variable for this (e.g.
# NEXT_PUBLIC_BACKEND_URL) — it would be ignored.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Host of the PRODUCTION backend (e.g. api.gridnova.in). A Vercel Preview build
# whose NEXT_PUBLIC_API_URL points at this host prints a loud warning, because
# test submissions would create real leads. Set it on Preview + Production.
# NEXT_PUBLIC_PRODUCTION_API_HOST=

# ── Clerk (auth) ─────────────────────────────────────────────────────────────
# From your Clerk instance's dashboard. The publishable key is public; the
# secret key is SERVER-ONLY. Both are required in production.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Lead capture (server-only) ───────────────────────────────────────────────
# Resend API key — powers the notification emails of app/api/estimate-request,
# app/api/configurator-lead and app/api/contact. SECRET. A lead is still saved
# to the CRM when Resend is down or this is unset (the routes succeed if either
# channel does), but staff then get no email.
RESEND_API_KEY=

# Where those emails go. Comma-separated list. Falls back to info@gridnova.in.
ESTIMATE_NOTIFY_EMAIL=

# Shared secret for the server-to-server lead mirror (website forms -> backend
# CRM) and any backend /internal/* call. SECRET, server-only — never prefix with
# NEXT_PUBLIC_. Must equal the backend's own INTERNAL_API_KEY. When unset the
# mirror omits X-Internal-Key / X-Customer-IP and every visitor shares one
# backend rate limit.
INTERNAL_API_KEY=

# ── Feature switches (public, build-time) ────────────────────────────────────
# Ask Nova live chat. ON by default (unset = on). To turn it off, uncomment and
# set to "false" and rebuild: the widget falls back to FAQ-only quick answers
# with no network call. Only the exact string "false" disables it.
# NEXT_PUBLIC_ASK_NOVA_ENABLED=false

# Associate Network switch. "true" shows Apply / Sign-in on the Careers page and
# opens the /associates/* and /preferred/* routes; "false" shows "opening soon"
# everywhere. When unset: open in development, CLOSED in production builds.
# Set to "true" only once the backend (with territory data loaded) is deployed.
# NEXT_PUBLIC_ASSOCIATE_PORTAL_OPEN=true

# ── Search Console ───────────────────────────────────────────────────────────
# Google Search Console verification: Search Console -> URL-prefix property ->
# "HTML tag" -> copy ONLY the `content` value of the meta tag. The tag is emitted
# on the public site only when this is set. Public (it is visible in the HTML).
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
